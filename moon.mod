// MoonBit module metadata.
// Reference: https://docs.moonbitlang.com/en/latest/toolchain/moon/module.html

name = "fan-ere/moon-pdf417-core"

version = "0.2.1"

readme = "README.md"

repository = "https://github.com/fan-ere/moon-pdf417-core"

license = "MIT"

keywords = [
  "pdf417",
  "barcode",
  "codewords",
  "reed-solomon",
  "encoding",
  "rendering",
  "svg",
  "gs1",
]

preferred_target = "wasm"

description = "Pure MoonBit PDF417 encoder: Text / Byte / Numeric compaction, the annex P mode selector, GF(929) Reed-Solomon parity with error repair, symbol layout, the annex A module patterns and SVG or ASCII rendering."
